        "\n",
        "# Practical 12: Value Iteration Algorithm\n",
        "# Deterministic 2x2 Grid World\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "# ---------------------------------------\n",
        "# 1. Define the MDP\n",
        "# ---------------------------------------\n",
        "\n",
        "states = [\"S0\", \"S1\", \"G\"]\n",
        "actions = [\"Up\", \"Down\", \"Left\", \"Right\"]\n",
        "\n",
        "gamma = 0.9\n",
        "normal_reward = -1\n",
        "goal_reward = 100\n",
        "theta = 0.001\n",
        "\n",
        "# Grid positions\n",
        "positions = {\n",
        "    \"S0\": (0, 0),\n",
        "    \"Wall\": (0, 1),\n",
        "    \"S1\": (1, 0),\n",
        "    \"G\": (1, 1)\n",
        "}\n",
        "\n",
        "# Initialize state values\n",
        "V = {\n",
        "    \"S0\": 0.0,\n",
        "    \"S1\": 0.0,\n",
        "    \"G\": 0.0\n",
        "}\n",
        "\n",
        "# Action movements\n",
        "moves = {\n",
        "    \"Up\": (-1, 0),\n",
        "    \"Down\": (1, 0),\n",
        "    \"Left\": (0, -1),\n",
        "    \"Right\": (0, 1)\n",
        "}\n",
        "\n",
        "\n",
        "# ---------------------------------------\n",
        "# 2. Define Transition Function\n",
        "# ---------------------------------------\n",
        "\n",
        "def transition(state, action):\n",
        "\n",
        "    if state == \"G\":\n",
        "        return \"G\", 0\n",
        "\n",
        "    row, col = positions[state]\n",
        "\n",
        "    dr, dc = moves[action]\n",
        "\n",
        "    new_row = row + dr\n",
        "    new_col = col + dc\n",
        "\n",
        "    # Check grid boundaries\n",
        "    if new_row < 0 or new_row > 1 or new_col < 0 or new_col > 1:\n",
        "        return state, normal_reward\n",
        "\n",
        "    # Check wall\n",
        "    if (new_row, new_col) == positions[\"Wall\"]:\n",
        "        return state, normal_reward\n",
        "\n",
        "    # Check goal\n",
        "    if (new_row, new_col) == positions[\"G\"]:\n",
        "        return \"G\", goal_reward\n",
        "\n",
        "    # Normal state movement\n",
        "    if (new_row, new_col) == positions[\"S0\"]:\n",
        "        return \"S0\", normal_reward\n",
        "\n",
        "    if (new_row, new_col) == positions[\"S1\"]:\n",
        "        return \"S1\", normal_reward\n",
        "\n",
        "\n",
        "# ---------------------------------------\n",
        "# 3. Display Transition Information\n",
        "# ---------------------------------------\n",
        "\n",
        "print(\"========== TRANSITION INFORMATION ==========\")\n",
        "\n",
        "for state in [\"S0\", \"S1\"]:\n",
        "\n",
        "    for action in actions:\n",
        "\n",
        "        next_state, reward = transition(state, action)\n",
        "\n",
        "        print(\n",
        "            f\"{state} --{action}--> {next_state}, \"\n",
        "            f\"Reward = {reward}\"\n",
        "        )\n",
        "\n",
        "\n",
        "# ---------------------------------------\n",
        "# 4. Value Iteration Algorithm\n",
        "# ---------------------------------------\n",
        "\n",
        "iteration = 0\n",
        "\n",
        "print(\"\\n========== ITERATION-WISE STATE VALUES ==========\")\n",
        "\n",
        "while True:\n",
        "\n",
        "    iteration += 1\n",
        "\n",
        "    delta = 0\n",
        "\n",
        "    new_V = V.copy()\n",
        "\n",
        "    for state in [\"S0\", \"S1\"]:\n",
        "\n",
        "        action_values = []\n",
        "\n",
        "        # Calculate Q(s,a) for all actions\n",
        "        for action in actions:\n",
        "\n",
        "            next_state, reward = transition(state, action)\n",
        "\n",
        "            q_value = reward + gamma * V[next_state]\n",
        "\n",
        "            action_values.append(q_value)\n",
        "\n",
        "        # Update state value using maximum Q value\n",
        "        new_V[state] = max(action_values)\n",
        "\n",
        "        # Calculate maximum change\n",
        "        delta = max(\n",
        "            delta,\n",
        "            abs(new_V[state] - V[state])\n",
        "        )\n",
        "\n",
        "    V = new_V\n",
        "\n",
        "    print(\n",
        "        f\"Iteration {iteration}: \"\n",
        "        f\"S0 = {V['S0']:.4f}, \"\n",
        "        f\"S1 = {V['S1']:.4f}, \"\n",
        "        f\"G = {V['G']:.4f}, \"\n",
        "        f\"Delta = {delta:.4f}\"\n",
        "    )\n",
        "\n",
        "    # Check convergence\n",
        "    if delta < theta:\n",
        "        break\n",
        "\n",
        "\n",
        "# ---------------------------------------\n",
        "# 5. Calculate Final Action Values\n",
        "# ---------------------------------------\n",
        "\n",
        "Q = {}\n",
        "\n",
        "for state in [\"S0\", \"S1\"]:\n",
        "\n",
        "    Q[state] = {}\n",
        "\n",
        "    for action in actions:\n",
        "\n",
        "        next_state, reward = transition(state, action)\n",
        "\n",
        "        Q[state][action] = reward + gamma * V[next_state]\n",
        "\n",
        "\n",
        "# ---------------------------------------\n",
        "# 6. Find Optimal Policy\n",
        "# ---------------------------------------\n",
        "\n",
        "policy = {}\n",
        "\n",
        "for state in [\"S0\", \"S1\"]:\n",
        "\n",
        "    best_action = max(\n",
        "        Q[state],\n",
        "        key=Q[state].get\n",
        "    )\n",
        "\n",
        "    policy[state] = best_action\n",
        "\n",
        "\n",
        "# ---------------------------------------\n",
        "# 7. Display Final State Values\n",
        "# ---------------------------------------\n",
        "\n",
        "print(\"\\n========== FINAL OPTIMAL STATE VALUES ==========\")\n",
        "\n",
        "for state in states:\n",
        "\n",
        "    print(f\"V*({state}) = {V[state]:.2f}\")\n",
        "\n",
        "\n",
        "# ---------------------------------------\n",
        "# 8. Display Final Action Value Table\n",
        "# ---------------------------------------\n",
        "\n",
        "print(\"\\n========== FINAL ACTION VALUE TABLE ==========\")\n",
        "\n",
        "print(f\"{'State':<10}\", end=\"\")\n",
        "\n",
        "for action in actions:\n",
        "    print(f\"{action:<12}\", end=\"\")\n",
        "\n",
        "print()\n",
        "\n",
        "for state in [\"S0\", \"S1\"]:\n",
        "\n",
        "    print(f\"{state:<10}\", end=\"\")\n",
        "\n",
        "    for action in actions:\n",
        "\n",
        "        print(\n",
        "            f\"{Q[state][action]:<12.2f}\",\n",
        "            end=\"\"\n",
        "        )\n",
        "\n",
        "    print()\n",
        "\n",
        "\n",
        "# ---------------------------------------\n",
        "# 9. Display Optimal Policy\n",
        "# ---------------------------------------\n",
        "\n",
        "print(\"\\n========== OPTIMAL POLICY ==========\")\n",
        "\n",
        "for state in [\"S0\", \"S1\"]:\n",
        "\n",
        "    print(f\"{state} : {policy[state]}\")\n",
        "\n",
        "print(\"G : Terminal\")\n",
        "\n",
        "\n",
        "# ---------------------------------------\n",
        "# 10. Bellman Optimality Verification\n",
        "# ---------------------------------------\n",
        "\n",
        "print(\"\\n========== BELLMAN VERIFICATION ==========\")\n",
        "\n",
        "for state in [\"S0\", \"S1\"]:\n",
        "\n",
        "    max_Q = max(Q[state].values())\n",
        "\n",
        "    print(\n",
        "        f\"V*({state}) = {V[state]:.2f}, \"\n",
        "        f\"max Q*({state},a) = {max_Q:.2f}\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ---------------------------------------\n",
        "# 11. Optimal Path\n",
        "# ---------------------------------------\n",
        "\n",
        "print(\"\\n========== OPTIMAL PATH ==========\")\n",
        "\n",
        "print(\"S0 -> S1 -> G\")\n"
      ],
